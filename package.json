{
  "name": "vscode-ibmi-detective",
  "displayName": "IBM i Detective",
  "description": "AI-assisted diagnostic layer for Code for IBM i — collects extension logs, searches known issues, and scores confidence so you can fix connection problems fast.",
  "publisher": "SangameshSBM",
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ibm i",
    "as400",
    "iseries",
    "codefori",
    "diagnostic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sangameshsbm/code-for-ibmi-detective"
  },
  "bugs": {
    "url": "https://github.com/Sangameshsbm/code-for-ibmi-detective/issues"
  },
  "homepage": "https://github.com/Sangameshsbm/code-for-ibmi-detective#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ibmiDetective.investigate",
        "title": "IBM i: Investigate Extension Issue",
        "category": "IBM i Detective"
      },
      {
        "command": "ibmiDetective.setGitHubToken",
        "title": "IBM i: Set GitHub Token",
        "category": "IBM i Detective"
      },
      {
        "command": "ibmiDetective.clearGitHubToken",
        "title": "IBM i: Clear GitHub Token",
        "category": "IBM i Detective"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ibmiDetective.investigate"
        },
        {
          "command": "ibmiDetective.setGitHubToken"
        },
        {
          "command": "ibmiDetective.clearGitHubToken"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "compile:tsc": "tsc --noEmit",
    "package": "node esbuild.js --production",
    "lint": "tsc --noEmit",
    "test": "node --require ts-node/register test/collect-diagnostics.test.ts && node --require ts-node/register test/match-symptom.test.ts",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.6",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
